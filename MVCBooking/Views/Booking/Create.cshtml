@model MVCBooking.Models.HotelBooking

@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create a New Booking</h1>

<form asp-action="CreateBooking" method="post">
    <div class="form-group">
        <label asp-for="GuestName">Guest Name</label>
        <input asp-for="GuestName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="RoomNumber">Room Number</label>
        <input asp-for="RoomNumber" type="number" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-success">Save Booking</button>
</form>

<p>
    <a href="/Booking/Index">Back to List</a>
</p>
