@model MVCBooking.Models.HotelBooking

<h1>Create New Booking</h1>

<div class="row">
    <div class="col-6">
        <div class="card">
            <div class="card-header">
                <h5>New Booking</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Booking" asp-action="CreateBooking" method="post">
                    <div class="mb-3">
                        <label class="form-label">Guest Name</label>
                        <input asp-for="GuestName" type="text" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Room Number</label>
                        <input asp-for="RoomNumber" type="number" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>